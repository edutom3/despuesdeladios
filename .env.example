# GEMINI_API_KEY: Required for Gemini AI API calls (document OCR & assistant).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://despuesdeladios.vercel.app).
APP_URL="MY_APP_URL"

# Optional Stripe secret key for live 19 EUR case checkout (falls back to test card mode when unset)
STRIPE_SECRET_KEY=""
CASE_PRICE_EUR="19"

# Optional Resend API key and verified sender address for automated email reminders and family invitations
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Después del adiós <onboarding@resend.dev>"
